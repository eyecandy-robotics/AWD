<mujoco model="eyecandy">

  <option iterations="1" ls_iterations="5">
    <flag eulerdamp="disable"/>
  </option>
    <compiler angle="radian"/>
  <default>
    <default class="robot">
      <default class="visual">
        <geom material="visualgeom" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom group="1" />
        <equality solimp="0.99 0.999 1e-05" solref="0.005 1" />
      </default>
    </default>
  </default>

  <asset>
    <material name="base_material" rgba="0.180392 0.180392 0.180392 1" />
    <material name="body_front_material" rgba="1 1 1 1" />
    <material name="body_electronix_cover_material" rgba="0 0 0 1" />
    <material name="roll_bearing_material" rgba="0.6 0.6 0.6 1" />
    <material name="head_attachment_2_material" rgba="0.909804 0.572549 0.164706 1" />
    <material name="tail_connector_material" rgba="0.647059 0.647059 0.647059 1" />
    <material name="right_roll_to_pitch_older_material" rgba="0.901961 0.901961 0.901961 1" />
    <material name="raspberrypizerow_material" rgba="0.231373 0.380392 0.705882 1" />
    <material name="motor_driver_material" rgba="0.917647 0.917647 0.917647 1" />
    <material name="powermodule_material" rgba="0.768627 0.886275 0.952941 1" />
    <material name="box_material" rgba="0.545098 0.545098 0.545098 1" />
    <material name="liion_material" rgba="0.796078 0.823529 0.937255 1" />
    <material name="default_material" rgba="0.7 0.7 0.7 1" />
    <material name="collision_material" rgba="1.0 0.28 0.1 0.9" />
    <mesh name="base.stl" file="./assets/base_convex.stl" />
    <mesh name="body_front.stl" file="./assets/body_front_convex.stl" />
    <mesh name="body_back.stl" file="./assets/body_back_convex.stl" />
    <mesh name="body_electronix_cover.stl" file="./assets/body_electronix_cover_convex.stl" />
    <mesh name="roll_bearing.stl" file="./assets/roll_bearing_convex.stl" />
    <mesh name="trunk_top.stl" file="./assets/trunk_top_convex.stl" />
    <mesh name="actuator.stl" file="./assets/actuator_convex.stl" />
    <mesh name="neck_left.stl" file="./assets/neck_left_convex.stl" />
    <mesh name="head_attachment.stl" file="./assets/head_attachment_convex.stl" />
    <mesh name="head_attachment__2.stl" file="./assets/head_attachment__2_convex.stl" />
    <mesh name="headdown.stl" file="./assets/headdown_convex.stl" />
    <mesh name="headup.stl" file="./assets/headup_convex.stl" />
    <mesh name="neck_right.stl" file="./assets/neck_right_convex.stl" />
    <mesh name="front_tail.stl" file="./assets/front_tail_convex.stl" />
    <mesh name="hind_tail.stl" file="./assets/hind_tail_convex.stl" />
    <mesh name="tail_connector.stl" file="./assets/tail_connector_convex.stl" />
    <mesh name="hip_actuator.stl" file="./assets/hip_actuator_convex.stl" />
    <mesh name="right_roll_to_pitch_older.stl" file="./assets/right_roll_to_pitch_older_convex.stl" />
    <mesh name="right_leg_thigh.stl" file="./assets/right_leg_thigh_convex.stl" />
    <mesh name="right_upper_cover.stl" file="./assets/right_upper_cover_convex.stl" />
    <mesh name="right_leg_shin.stl" file="./assets/right_leg_shin_convex.stl" />
    <mesh name="right_foot_ankle.stl" file="./assets/right_foot_ankle_convex.stl" />
    <mesh name="right_foot_cover.stl" file="./assets/right_foot_cover_convex.stl" />
    <mesh name="right_foot_tpu.stl" file="./assets/right_foot_tpu_convex.stl" />
    <mesh name="left_roll_to_pitch_older.stl" file="./assets/left_roll_to_pitch_older_convex.stl" />
    <mesh name="left_motor_thigh.stl" file="./assets/left_motor_thigh_convex.stl" />
    <mesh name="left_upper_cover.stl" file="./assets/left_upper_cover_convex.stl" />
    <mesh name="left_leg_shin.stl" file="./assets/left_leg_shin_convex.stl" />
    <mesh name="left_foot_ankle.stl" file="./assets/left_foot_ankle_convex.stl" />
    <mesh name="left_foot_cover.stl" file="./assets/left_foot_cover_convex.stl" />
    <mesh name="left_foot_tpu.stl" file="./assets/left_foot_tpu_convex.stl" />
    <mesh name="raspberrypizerow.stl" file="./assets/raspberrypizerow_convex.stl" />
    <mesh name="motor_driver.stl" file="./assets/motor_driver_convex.stl" />
    <mesh name="powermodule.stl" file="./assets/powermodule_convex.stl" />
    <mesh name="box.stl" file="./assets/box_convex.stl" />
    <mesh name="liion.stl" file="./assets/liion_convex.stl" />
  </asset>
  
  
 <default>
    <default class="sts3215">
	<geom contype="0" conaffinity="0"/>
	<joint damping="0.60" frictionloss="0.052" armature="0.028"/>
	<position kp="17.8" kv="0.0" forcerange="-3.35 3.35"/>
    </default>
    <default class="backlash">
	<!-- +/- 0.5° of backlash -->
	<joint damping="0.01" frictionloss="0" armature="0.01" limited="true"
	    range="-0.008726646259971648 0.008726646259971648"/>
    </default>
    <default class="open_duck_mini_v2">
      <joint frictionloss="0.1" armature="0.005"/>
      <position kp="50" dampratio="1"/>
    </default>
 </default>
  
  
  <!-- Additional sensors -->
  <sensor>
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framexaxis objtype="site" objname="imu" name="forwardvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framepos objtype="site" objname="imu" name="position"/>
    <framequat objtype="site" objname="imu" name="orientation"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
    <framexaxis objtype="site" objname="left_foot" name="left_foot_upvector"/>
    <framexaxis objtype="site" objname="right_foot" name="right_foot_upvector"/>
    <framepos objtype="site" objname="left_foot" name="left_foot_pos"/>
    <framepos objtype="site" objname="right_foot" name="right_foot_pos"/>
  </sensor>

  <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
            width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    </asset>
  
  <worldbody>
